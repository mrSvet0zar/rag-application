# ============================================================
#  Backend environment variables (copy to .env and fill in)
# ============================================================

# --- Database ---
# Matches docker-compose.yml credentials.
DATABASE_URL=postgresql://rag_user:rag_password@localhost:5432/rag_db
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# --- LLM (Anthropic / Claude) ---
# Get one at https://console.anthropic.com/. Leave empty to run in DEMO mode
# (retrieval works, answers are generated from a local template instead of Claude).
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-5
MAX_TOKENS=1024

# --- Embeddings (local, no API key needed) ---
# Multilingual model -> 384 dimensions. If you change the model, update
# PGVECTOR_DIMENSION and add a migration altering chunks.embedding.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
PGVECTOR_DIMENSION=384

# --- App config ---
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- RAG config ---
CHUNK_SIZE=1024
CHUNK_OVERLAP=200
MIN_RELEVANCE_SCORE=0.25
TOP_K_RETRIEVAL=5

# --- Reranking (cross-encoder) ---
# Fetch RERANK_CANDIDATES chunks by similarity, then re-score with a
# cross-encoder and keep the best k. Loads a 2nd model (~500 MB RAM) — set
# RERANK_ENABLED=false on a memory-constrained host.
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_CANDIDATES=20
RERANK_MIN_SCORE=0.05
