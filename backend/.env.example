# ============================================================
#  Backend environment variables (copy to .env and fill in)
# ============================================================

# --- Database ---
# Matches docker-compose.yml credentials.
DATABASE_URL=postgresql://rag_user:rag_password@localhost:5432/rag_db
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# --- LLM (Anthropic / Claude) ---
# Get one at https://console.anthropic.com/. Leave empty to run in DEMO mode
# (retrieval works, answers are generated from a local template instead of Claude).
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-5
MAX_TOKENS=1024

# --- Embeddings (local, no API key needed) ---
# Multilingual model -> 384 dimensions. If you change the model, update
# PGVECTOR_DIMENSION and add a migration altering chunks.embedding.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
PGVECTOR_DIMENSION=384

# --- App config ---
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limiting ---
# Ne s'applique qu'aux endpoints coûteux (chat, upload, import d'URL) : une
# question déclenche un appel LLM facturé, un upload fait tourner un modèle.
# Les seaux sont en mémoire du processus : avec plusieurs répliques, chacune
# applique la limite séparément.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
# true derrière un proxy de confiance (Railway) qui écrit X-Forwarded-For ;
# false si l'application est exposée directement, sinon l'en-tête est forgeable.
TRUST_PROXY_HEADERS=true

# --- Logs ---
LOG_FORMAT=json

# --- RAG config ---
# Valeurs retenues par mesure (voir docs/EVALUATION.md), pas par habitude.
CHUNK_SIZE=512
CHUNK_OVERLAP=100
MIN_RELEVANCE_SCORE=0.25
TOP_K_RETRIEVAL=5

# --- Recherche hybride (lexical + vectoriel) ---
# Le vectoriel est aveugle aux termes exacts (sigles, noms propres, titres
# étrangers) ; une passe lexicale full-text couvre exactement ce trou. Les deux
# classements sont fusionnés par Reciprocal Rank Fusion.
HYBRID_ENABLED=true
LEXICAL_CANDIDATES=20
RRF_K=60

# --- Reranking (cross-encoder) ---
# Fetch RERANK_CANDIDATES chunks by similarity, then re-score with a
# cross-encoder and keep the best k. Loads a 2nd model (~500 MB RAM) — set
# RERANK_ENABLED=false on a memory-constrained host.
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_CANDIDATES=20
# Budget du cross-encoder. Distinct du pool par moteur : fusionner deux
# classements de 20 en produit jusqu'à 40, et retomber à 20 jetterait
# l'essentiel de l'apport lexical avant même de le juger.
RERANK_MAX_CANDIDATES=40
RERANK_MIN_SCORE=0.05
